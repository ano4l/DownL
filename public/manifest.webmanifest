{
  "id": "/",
  "name": "Pocket — Media Downloader",
  "short_name": "Pocket",
  "description": "Keep your finds from Pinterest, X and TikTok.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8f3",
